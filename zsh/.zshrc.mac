DISABLE_AUTO_UPDATE="true"
HIST_STAMPS="yyyy-mm-dd"
plugins=(git autojump sudo cp colored-man-pages extract)

## autojump load
[[ -s ~/.autojump/etc/profile.d/autojump.sh ]] && source ~/.autojump/etc/profile.d/autojump.sh
autoload -U compinit && compinit -u

# Third-party zsh plugins installed via Homebrew
[[ -s /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]] && source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
[[ -s /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] && source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# user configuration

export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"
# export MANPATH="/opt/homebrew/share/man:$MANPATH"

## uv
if command -v uv >/dev/null 2>&1; then
    eval "$(uv generate-shell-completion zsh)"
fi
if command -v uvx >/dev/null 2>&1; then
    eval "$(uvx --generate-shell-completion zsh)"
fi

. $ZSH/oh-my-zsh.sh

# you may need to manually set your language environment
# export lang=en_us.utf-8
if [[ -z $LANG ]]; then
    export LC_ALL=en_US.UTF-8
    export LANG=en_US.UTF-8
fi

## tmux alias
alias tn="tmux new -s"
alias ta="tmux attach -t"
alias tl="tmux ls"

# User alias configuration
if [ -f ~/.bash_aliases ]; then
    source ~/.bash_aliases
fi

# Binary mirror source for Homebrew
export HOMEBREW_BOTTLE_DOMAIN=https://mirrors.tuna.tsinghua.edu.cn/homebrew-bottles

# Starship prompt
eval "$(starship init zsh)"
